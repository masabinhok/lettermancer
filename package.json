{
  "name": "lettermancer",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lettermancer/web",
    "build": "npm run build -w @lettermancer/web",
    "preview": "npm run preview -w @lettermancer/web --",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run check -w @lettermancer/web && tsc -p packages/engine --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playtest": "node scripts/playtest.mjs",
    "bundle:engine": "esbuild packages/engine/src/index.ts --bundle --format=esm --platform=neutral --outfile=supabase/functions/_shared/engine.js --legal-comments=none",
    "test:cloud": "vitest run --project cloud",
    "supabase:start": "npm run bundle:engine && npx supabase start",
    "test:e2e:cloud": "CLOUD=1 playwright test e2e/cloud",
    "layout": "node scripts/layout-sweep.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@supabase/supabase-js": "^2.117.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wordlist-english": "^1.2.1"
  }
}
