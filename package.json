{
  "name": "keycraft",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @keycraft/web",
    "build": "npm run build -w @keycraft/web",
    "preview": "npm run preview -w @keycraft/web",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run check -w @keycraft/web && tsc -p packages/engine --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "playtest": "node scripts/playtest.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wordlist-english": "^1.2.1"
  }
}
